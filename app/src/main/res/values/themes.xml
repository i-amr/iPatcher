<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">

        <!-- Primary brand color. -->
        <item name="android:colorPrimary">#5865F2</item>
        <!-- Secondary brand color. -->
        <item name="android:colorSecondary">#5865F2</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">#08074D</item>
        <!-- Customize your theme here. -->
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:buttonStyle">@style/ButtonTheme</item>
        <item name="android:progressBarStyle">@style/ProgressBarTheme</item>
        <item name="android:progressBarStyleHorizontal">@style/ProgressBarTheme</item>
    </style>

    <style name="ButtonTheme" parent="@android:style/Widget.Button">
        <item name="android:background">@drawable/button_background</item>
        <item name="android:drawableLeft">@drawable/ic_patch</item>
        <item name="android:drawableTint">#000</item>
        <item name="android:fontFamily">@font/ggsans_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ProgressBarTheme" parent="@android:style/Widget.Holo.ProgressBar.Horizontal">
        <item name="android:progressTint">#fff</item>
    </style>

</resources>
